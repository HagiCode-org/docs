---
import { getStructuredArticleViewModel } from '@/lib/articles.mjs';

const locale = typeof Astro.props.locale === 'string' ? Astro.props.locale : 'zh-CN';
const slug = typeof Astro.props.slug === 'string' ? Astro.props.slug : '';
const { faq } = getStructuredArticleViewModel(slug, locale);
---

<dl class="structured-article-faq">
  {faq.map((entry) => (
    <div class="structured-article-faq__item">
      <dt>{entry.question}</dt>
      <dd>{entry.answer}</dd>
    </div>
  ))}
</dl>

<style>
  .structured-article-faq {
    display: grid;
    gap: 0;
    max-width: 48rem;
    margin: 0;
  }

  .structured-article-faq__item {
    padding: 1rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .structured-article-faq__item:last-child {
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  dt {
    margin: 0 0 0.35rem;
    font-weight: 600;
    font-size: var(--sl-text-body);
    color: var(--sl-color-white);
  }

  dd {
    margin: 0;
    line-height: 1.65;
    color: var(--sl-color-text);
  }
</style>
