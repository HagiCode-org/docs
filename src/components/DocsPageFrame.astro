---
import PageFrame from '@astrojs/starlight/components/PageFrame.astro';
import PromotoBanner from '@hagicode/hagilight/PromotoBanner';
import { getDocsPromoteFallback } from '@/lib/docs-promote-fallback';

const route = Astro.locals.starlightRoute;
const fallback = getDocsPromoteFallback(route.lang);
const promotion = {
  id: fallback.id,
  title: fallback.title,
  description: fallback.description,
  ctaLabel: fallback.ctaLabel,
  link: fallback.link,
};
---

<PageFrame>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</PageFrame>
<PromotoBanner fallback={promotion} locale={route.lang} />
