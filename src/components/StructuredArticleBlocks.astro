---
import { gaEventAttributes } from '@hagicode/hagilight-core/analytics-events';
import { localizeDocsHref } from '@/lib/articles.mjs';

const { blocks = [], locale = 'zh-CN' } = Astro.props;
---

{blocks.map((block) => {
  switch (block.type) {
    case 'rich-text':
      return (
        <div class="structured-block structured-rich-text">
          {block.content.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      );
    case 'bullet-list':
      return (
        <ul class="structured-block structured-bullet-list">
          {block.items.map((item) => <li>{item}</li>)}
        </ul>
      );
    case 'capability-list':
      return (
        <div class="structured-block structured-capability-list">
          {block.items.map((item) => (
            <article class="capability-item">
              <h3>{item.title}</h3>
              {item.content.map((paragraph) => <p>{paragraph}</p>)}
              {item.bullets?.length ? (
                <ul>
                  {item.bullets.map((entry) => <li>{entry}</li>)}
                </ul>
              ) : null}
            </article>
          ))}
        </div>
      );
    case 'comparison-grid':
      return (
        <div class="structured-block structured-comparison-grid">
          {block.items.map((item) => (
            <article class="comparison-card">
              <h3>{item.label}</h3>
              <dl>
                <div>
                  <dt>Agent</dt>
                  <dd>{item.agent}</dd>
                </div>
                <div>
                  <dt>HagiCode</dt>
                  <dd>{item.hagicode}</dd>
                </div>
                {item.combinedValue ? (
                  <div>
                    <dt>Combined value</dt>
                    <dd>{item.combinedValue}</dd>
                  </div>
                ) : null}
              </dl>
            </article>
          ))}
        </div>
      );
    case 'comparison-table':
      return (
        <div class="structured-block structured-table-wrap" tabindex="0" role="region" aria-label={block.caption ?? block.headers.join(' / ')}>
          <table class="structured-table">
            {block.caption ? <caption>{block.caption}</caption> : null}
            <thead>
              <tr>
                {block.headers.map((header) => <th scope="col">{header}</th>)}
              </tr>
            </thead>
            <tbody>
              {block.rows.map((row) => (
                <tr>
                  {row.cells.map((cell, index) =>
                    index === 0 ? <th scope="row">{cell}</th> : <td data-label={block.headers[index]}>{cell}</td>,
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    case 'callout':
      return (
        <aside class={`structured-block structured-callout tone-${block.tone}`}>
          {block.title ? <p class="structured-callout__title">{block.title}</p> : null}
          {block.content.map((paragraph) => <p>{paragraph}</p>)}
        </aside>
      );
    case 'cta-group':
      return (
        <div class="structured-block structured-cta-group">
          {block.items.map((item) => (
            <a
              class={item.variant === 'secondary' ? 'secondary' : 'primary'}
              href={localizeDocsHref(item.href, locale)}
              {...gaEventAttributes({
                category: 'navigation',
                label: item.variant === 'secondary' ? 'articleCtaSecondary' : 'articleCtaPrimary',
                location: 'article_cta',
              })}
            >{item.label}</a>
          ))}
        </div>
      );
    default:
      throw new Error(`Unsupported structured article block type: ${block.type}`);
  }
})}

<style>
  .structured-block p,
  .structured-block ul,
  .structured-block dl,
  .structured-block h3 {
    margin: 0;
  }

  .structured-rich-text,
  .structured-callout,
  .structured-cta-group {
    display: grid;
    gap: 0.9rem;
  }

  .structured-rich-text p {
    line-height: 1.7;
  }

  .structured-bullet-list {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 1.25rem;
    line-height: 1.65;
  }

  /* One column, no boxes: long text reads best as a stream with a heading per item. */
  .structured-capability-list {
    display: grid;
    gap: 1.6rem;
  }

  .capability-item {
    display: grid;
    gap: 0.6rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--sl-color-gray-5);
  }

  .capability-item h3 {
    font-size: var(--sl-text-h4);
    line-height: 1.3;
    color: var(--sl-color-white);
  }

  .capability-item p,
  .capability-item li {
    line-height: 1.7;
  }

  .capability-item ul {
    display: grid;
    gap: 0.35rem;
    padding-inline-start: 1.25rem;
  }

  /* Legacy comparison-grid blocks (other locales): label plus a two-line definition list, single column. */
  .structured-comparison-grid {
    display: grid;
    gap: 1.2rem;
  }

  .comparison-card {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--sl-color-gray-5);
  }

  .comparison-card h3 {
    margin-bottom: 0.5rem;
    font-size: var(--sl-text-h4);
    color: var(--sl-color-white);
  }

  .comparison-card dl {
    display: grid;
    gap: 0.6rem;
  }

  .comparison-card dt {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-text-2);
  }

  .comparison-card dd {
    margin: 0.15rem 0 0;
    line-height: 1.6;
  }

  .structured-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .structured-table-wrap:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .structured-table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-family: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .structured-table caption {
    padding: 0.6rem 0.9rem;
    text-align: start;
    caption-side: bottom;
    color: var(--sl-color-text-2);
  }

  .structured-table th,
  .structured-table td {
    padding: 0.7rem 0.9rem;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .structured-table thead th {
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    white-space: nowrap;
  }

  .structured-table tbody th {
    width: 22%;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .structured-table tbody tr:nth-child(even) > * {
    background: color-mix(in srgb, var(--sl-color-bg-nav) 55%, transparent);
  }

  .structured-table tbody tr:last-child > * {
    border-bottom: none;
  }

  /* Narrow screens: each row becomes a small card, so no column is hidden behind a sideways swipe. */
  @media (max-width: 640px) {
    .structured-table-wrap {
      overflow: visible;
      border: none;
    }

    .structured-table,
    .structured-table tbody,
    .structured-table tr {
      display: block;
      min-width: 0;
    }

    .structured-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .structured-table tr {
      margin-bottom: 0.9rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      overflow: hidden;
    }

    .structured-table tbody th {
      display: block;
      width: auto;
      background: var(--sl-color-bg-nav);
      border-bottom: 1px solid var(--sl-color-gray-5);
    }

    .structured-table td {
      display: block;
    }

    .structured-table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.15rem;
      font-size: var(--sl-text-xs);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--sl-color-text-2);
    }

    .structured-table tbody tr:nth-child(even) > * {
      background: none;
    }

    .structured-table tbody tr:nth-child(even) > th {
      background: var(--sl-color-bg-nav);
    }

    .structured-table tbody tr:last-child > td:last-child {
      border-bottom: none;
    }
  }

  .structured-callout {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start-width: 4px;
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }

  .structured-callout__title {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .structured-callout p {
    line-height: 1.65;
  }

  .structured-callout.tone-info {
    border-inline-start-color: var(--sl-color-accent);
  }

  .structured-callout.tone-success {
    border-inline-start-color: var(--sl-color-green);
  }

  .structured-callout.tone-warning {
    border-inline-start-color: var(--sl-color-orange);
  }

  .structured-cta-group {
    grid-template-columns: repeat(auto-fit, minmax(13rem, max-content));
  }

  .structured-cta-group a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.9rem;
    padding: 0.72rem 1.1rem;
    border-radius: 0.95rem;
    border: 1px solid transparent;
    text-decoration: none;
    font-weight: 600;
    line-height: 1.2;
    box-shadow: 0 10px 26px rgb(37 99 235 / 0.08);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .structured-cta-group a::after {
    content: '->';
    font-size: 0.82em;
  }

  .structured-cta-group a:hover {
    transform: translateY(-1px);
  }

  .structured-cta-group a.primary {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--sl-color-accent) 88%, white),
      var(--sl-color-accent)
    );
    color: var(--sl-color-white);
    box-shadow: 0 14px 30px rgb(37 99 235 / 0.16);
  }

  .structured-cta-group a.secondary {
    border-color: var(--sl-color-gray-5);
    color: var(--sl-color-text);
    background: color-mix(in srgb, var(--sl-color-bg) 94%, var(--sl-color-bg-nav) 6%);
  }

  .structured-cta-group a.secondary:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 28%, var(--sl-color-gray-5));
    color: var(--sl-color-accent-high);
  }

  @media (prefers-reduced-motion: reduce) {
    .structured-cta-group a {
      transition: none;
    }

    .structured-cta-group a:hover {
      transform: none;
    }
  }
</style>
