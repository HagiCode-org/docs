---
/**
 * Product-overview feature index: every headline capability on one screen, each with the problem it
 * answers and a jump link to its detailed section further down the page. Plain links, no script.
 */
interface Item {
  /** Feature name, e.g. "Sessions and proposals". */
  title: string;
  /** The reader's problem or the outcome, in one sentence. */
  summary: string;
  /** In-page anchor of the detailed section, e.g. "#sessions". */
  href: string;
}

interface Props {
  /** Accessible name of the list. */
  label: string;
  items: Item[];
}

const { label, items } = Astro.props as Props;
---

<ol class="feature-index not-content" aria-label={label}>
  {
    items.map((item, index) => (
      <li class="feature-index__item">
        <a class="feature-index__link" href={item.href}>
          <span class="feature-index__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="feature-index__text">
            <span class="feature-index__title">{item.title}</span>
            <span class="feature-index__summary">{item.summary}</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .feature-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .feature-index__item {
    margin: 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .feature-index__item:nth-child(odd) {
    padding-inline-end: 1rem;
  }

  .feature-index__item:nth-child(even) {
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  /* An odd last item spans the row instead of leaving an empty cell. */
  .feature-index__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    padding-inline-end: 0;
  }

  .feature-index__link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding-block: 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .feature-index__number {
    flex: none;
    font-size: var(--sl-text-sm);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }

  .feature-index__text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .feature-index__title {
    font-size: var(--sl-text-base);
    font-weight: 700;
    line-height: 1.35;
    color: var(--sl-color-text-high);
    transition: color 180ms ease;
  }

  .feature-index__summary {
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  .feature-index__link:hover .feature-index__title {
    color: var(--sl-color-text-accent);
  }

  .feature-index__link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  @media (max-width: 40rem) {
    .feature-index {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature-index__item:nth-child(odd),
    .feature-index__item:nth-child(even) {
      padding-inline: 0;
      border-inline-start: 0;
    }
  }
</style>
