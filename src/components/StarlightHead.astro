---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import GoogleAnalytics from '@hagicode/hagilight/GoogleAnalytics';
import Clarity from './Clarity.astro';

const isValidPage = Astro.url.pathname !== '/404';
---

<script is:inline>
  (() => {
    const root = document.documentElement;
    const key = 'hagilight-content-width';
    const legacyKey = 'hagicode-docs-content-layout';
    const isValidMode = (value) => value === 'wide' || value === 'narrow';
    let mode = 'wide';

    try {
      const savedMode = localStorage.getItem(key);
      if (isValidMode(savedMode)) {
        mode = savedMode;
      } else {
        const legacyMode = localStorage.getItem(legacyKey);
        if (isValidMode(legacyMode)) {
          mode = legacyMode;
          localStorage.setItem(key, legacyMode);
        }
      }
    } catch {}

    root.dataset.hagilightContentWidth = mode;
  })();
</script>
<DefaultHead />
{isValidPage && (
  <>
    <meta name="baidu-site-verification" content="codeva-A9s3yT3z5m" />
    <script type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>
    <script>
      import '../scripts/lang-redirect.js';
    </script>
  </>
)}
<Clarity />
