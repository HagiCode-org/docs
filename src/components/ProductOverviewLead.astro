---
import { Picture } from 'astro:assets';
import heroAvatar from '@/assets/r2/hero-avatars/robot-foundry-07.avif';
import { getR2Entry, getR2PoolObjectKeys } from '@/lib/r2-images';

/** Opening block of the product overview: the two actions a reader wants first, then the facts they check before installing. */
interface Props {
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  /** Short, self-contained statements (supported tools, platforms, price). */
  facts: string[];
}

const { primaryLabel, primaryHref, secondaryLabel, secondaryHref, facts } = Astro.props as Props;
/** Decorative avatar: vendored default in the HTML, optional random swap from the manifest pool. */
const avatar = getR2Entry('product-overview-lead');
const avatarPool = getR2PoolObjectKeys(avatar);
---

<div class="po-lead not-content">
  <div class="po-lead__actions">
    <a class="po-lead__primary" href={primaryHref}>
      <span>{primaryLabel}</span>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <path
          d="M3 8h9.5M8.5 3.75 12.75 8 8.5 12.25"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
    <a class="po-lead__secondary" href={secondaryHref}>{secondaryLabel}</a>
    <div class="po-lead__avatar" aria-hidden="true">
      <Picture
        src={heroAvatar}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[144, 288]}
        sizes="72px"
        width={72}
        height={72}
        alt=""
        loading="eager"
        decoding="async"
        pictureAttributes={{ 'data-r2-pool': JSON.stringify(avatarPool) }}
      />
    </div>
  </div>

  <ul class="po-lead__facts">
    {facts.map((fact) => <li>{fact}</li>)}
  </ul>
</div>

<style>
  .po-lead {
    margin-block: 1.5rem 2rem;
  }

  .po-lead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .po-lead__avatar {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    margin-inline-start: auto;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    background: var(--sl-color-bg-nav);
  }

  .po-lead__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .po-lead__primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 1.1rem 0 1.25rem;
    border-radius: 0.875rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font-size: var(--sl-text-base);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .po-lead__primary svg {
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .po-lead__primary:hover {
    background: color-mix(in srgb, var(--sl-color-text-accent) 84%, var(--sl-color-white));
  }

  .po-lead__primary:hover svg {
    transform: translateX(3px);
  }

  .po-lead__primary:active {
    transform: translateY(1px);
  }

  .po-lead__secondary {
    color: var(--sl-color-text-high);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--sl-color-gray-4);
    text-underline-offset: 0.28em;
    transition: text-decoration-color 180ms ease;
  }

  .po-lead__secondary:hover {
    text-decoration-color: var(--sl-color-text-accent);
  }

  .po-lead__primary:focus-visible,
  .po-lead__secondary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  .po-lead__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 1.5rem 0 0;
    padding: 0;
    border-block: 1px solid var(--sl-color-hairline);
    list-style: none;
  }

  .po-lead__facts li {
    margin: 0;
    padding: 0.85rem 1rem;
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .po-lead__facts li:first-child {
    padding-inline-start: 0;
  }

  .po-lead__facts li + li {
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  @media (max-width: 40rem) {
    .po-lead__avatar {
      width: 3.5rem;
      height: 3.5rem;
    }

    .po-lead__facts {
      grid-template-columns: 1fr;
    }

    .po-lead__facts li {
      padding-inline: 0;
    }

    .po-lead__facts li + li {
      border-inline-start: 0;
      border-top: 1px solid var(--sl-color-hairline);
    }
  }
</style>

<script>
  import { initR2RandomImages } from '@/scripts/r2-random-image';

  initR2RandomImages();
</script>
