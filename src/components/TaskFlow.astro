---
/**
 * Product-overview walkthrough: one development task in four steps, each tied to the real screenshot
 * it happens in. Without JavaScript every step renders as a plain heading, screenshot and paragraph.
 * With JavaScript the steps become a keyboard-operable tab set that shares one screenshot stage.
 */
import { Image, getImage } from 'astro:assets';
import workspace from '@/content/docs/img/screenshots/product/conversation-session/original.png';
import proposal from '@/content/docs/img/screenshots/product/create-proposal/original.png';
import outcome from '@/content/docs/img/screenshots/product/proposal-complete/original.png';
import board from '@/content/docs/img/screenshots/product/session-board/original.png';

const IMAGES = {
  workspace: { src: workspace, position: '50% 0%' },
  proposal: { src: proposal, position: '50% 0%' },
  outcome: { src: outcome, position: '50% 0%' },
  board: { src: board, position: '50% 0%' },
} as const;

// The lightbox opens the largest srcset candidate, not the smaller one the browser picked for the inline slot.
const LIGHTBOX_WIDTH = 1920;
const lightbox = Object.fromEntries(
  await Promise.all(
    Object.entries(IMAGES).map(async ([key, { src }]) => {
      const full = await getImage({ src, width: LIGHTBOX_WIDTH, format: 'avif', quality: 70 });
      return [key, { src: full.src, width: full.attributes.width, height: full.attributes.height }];
    }),
  ),
) as Record<keyof typeof IMAGES, { src: string; width?: number; height?: number }>;

interface Step {
  /** Short action name shown on the tab, e.g. "Understand first". */
  label: string;
  /** One or two sentences. Supports **bold** and [text](href) only. */
  body: string;
  image: keyof typeof IMAGES;
  /** Describes the screenshot; shown as the caption and used as the image alt text. */
  alt: string;
}

interface Props {
  /** Accessible name of the step tabs. */
  label: string;
  /** Label of the "go to the next step" button. */
  nextLabel: string;
  steps: Step[];
}

const { label, nextLabel, steps } = Astro.props as Props;

function escapeHtml(value: string) {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
}

// Only the two inline forms our own overview copy uses; everything else is escaped text.
function renderInline(value: string) {
  return escapeHtml(value)
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---

<section class="task-flow not-content" data-task-flow style={`--tf-count: ${steps.length}; --tf-index: 0;`}>
  <div class="task-flow__tabs" data-tf-tabs aria-label={label} hidden>
    {
      steps.map((step, index) => (
        <button type="button" class="task-flow__tab" data-tf-tab={index}>
          <span class="task-flow__tab-number" aria-hidden="true">{index + 1}</span>
          <span class="task-flow__tab-label">{step.label}</span>
        </button>
      ))
    }
  </div>

  <div class="task-flow__panels">
    {
      steps.map((step, index) => {
        const image = IMAGES[step.image];
        const full = lightbox[step.image];
        return (
          <article class:list={['task-flow__panel', index === 0 && 'is-active']} data-tf-panel={index}>
            <h3 class="task-flow__heading">
              <span class="task-flow__heading-number" aria-hidden="true">{index + 1}</span>
              {step.label}
            </h3>
            <figure class="task-flow__figure">
              <div class="task-flow__frame">
                <Image
                  class="task-flow__image"
                  src={image.src}
                  alt={step.alt}
                  widths={[640, 960, 1280, 1600, 1920]}
                  sizes="(min-width: 50rem) 45rem, 100vw"
                  format="avif"
                  quality={70}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  data-lightbox-src={full.src}
                  data-lightbox-width={full.width}
                  data-lightbox-height={full.height}
                  style={`object-position: ${image.position};`}
                />
              </div>
              <figcaption class="task-flow__caption" aria-hidden="true">{step.alt}</figcaption>
            </figure>
            <div class="task-flow__text">
              <p class="task-flow__body" set:html={renderInline(step.body)} />
              {
                index < steps.length - 1 && (
                  <button type="button" class="task-flow__next" data-tf-next hidden>
                    <span>{nextLabel}</span>
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                      <path
                        d="M3 8h9.5M8.5 3.75 12.75 8 8.5 12.25"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                )
              }
            </div>
          </article>
        );
      })
    }
  </div>

  <script is:inline>
    (function () {
      var root = document.currentScript && document.currentScript.closest('[data-task-flow]');
      if (!root) return;

      var tabsEl = root.querySelector('[data-tf-tabs]');
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-tf-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-tf-panel]'));
      if (!tabsEl || tabs.length < 2 || tabs.length !== panels.length) return;

      var uid = 'task-flow';
      var current = 0;
      var leaveTimer = null;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      tabsEl.hidden = false;
      tabsEl.setAttribute('role', 'tablist');
      tabs.forEach(function (tab, i) {
        tab.id = uid + '-tab-' + i;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', uid + '-panel-' + i);
      });
      panels.forEach(function (panel, i) {
        panel.id = uid + '-panel-' + i;
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', uid + '-tab-' + i);
        panel.querySelectorAll('[data-tf-next]').forEach(function (next) {
          next.hidden = false;
        });
      });

      function paint() {
        root.style.setProperty('--tf-index', String(current));
        tabs.forEach(function (tab, i) {
          var selected = i === current;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
        });
      }

      function select(index, moveFocus) {
        index = Math.max(0, Math.min(panels.length - 1, index));
        if (index === current) {
          if (moveFocus) tabs[index].focus();
          return;
        }

        var previous = current;
        root.dataset.dir = index > previous ? 'forward' : 'back';
        // Commit the new direction before the classes flip so the incoming panel starts from the right edge.
        void root.offsetWidth;

        window.clearTimeout(leaveTimer);
        panels.forEach(function (panel) {
          panel.classList.remove('is-leaving');
        });
        panels[previous].classList.remove('is-active');
        if (!reduceMotion.matches) panels[previous].classList.add('is-leaving');
        panels[index].classList.add('is-active');
        current = index;
        paint();
        if (moveFocus) tabs[index].focus();

        leaveTimer = window.setTimeout(function () {
          panels[previous].classList.remove('is-leaving');
        }, 900);
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          select(i, false);
        });
      });

      tabsEl.addEventListener('keydown', function (event) {
        var next = null;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = current + 1;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = current - 1;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        if (next === null) return;
        event.preventDefault();
        select(next, true);
      });

      root.querySelectorAll('[data-tf-next]').forEach(function (button) {
        button.addEventListener('click', function () {
          select(current + 1, false);
        });
      });

      root.dataset.dir = 'forward';
      root.setAttribute('data-enhanced', '');
      paint();
    })();
  </script>
</section>

<style is:global>
  .task-flow {
    --tf-dur: 900ms;
    --tf-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --tf-radius: 0.75rem;
    margin-block: 1.5rem 2rem;
  }

  /* ---- Without JavaScript: a plain illustrated list ---- */
  .task-flow__panels {
    display: grid;
    gap: 2.5rem;
  }

  .task-flow__heading {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-lg);
    font-weight: 700;
    line-height: 1.3;
    color: var(--sl-color-text-high);
  }

  .task-flow__heading-number {
    flex: none;
    min-width: 1.5em;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-text-accent);
  }

  .task-flow__figure {
    margin: 0;
  }

  .task-flow__frame {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--tf-radius);
    background: var(--sl-color-bg-nav);
  }

  .task-flow__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }

  .task-flow__caption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .task-flow__text {
    margin-top: 0.9rem;
  }

  .task-flow__body {
    margin: 0;
    font-size: var(--sl-text-base);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .task-flow__body a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .task-flow__body a:hover {
    text-decoration-thickness: 2px;
  }

  .task-flow__body strong {
    color: var(--sl-color-text-high);
  }

  .task-flow__next {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    margin-top: 1rem;
    padding: 0 0.9rem 0 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.625rem;
    background: transparent;
    color: var(--sl-color-text-high);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .task-flow__next[hidden] {
    display: none;
  }

  .task-flow__next svg {
    transition: transform 260ms var(--tf-ease);
  }

  .task-flow__next:hover {
    border-color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent-low) 55%, transparent);
    color: var(--sl-color-text-accent);
  }

  .task-flow__next:hover svg {
    transform: translateX(3px);
  }

  .task-flow__next:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .task-flow__tab:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  /* ---- With JavaScript: tabs + one shared stage ---- */
  .task-flow__tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--tf-count), minmax(0, 1fr));
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .task-flow__tabs[hidden] {
    display: none;
  }

  .task-flow__tabs::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: calc(100% / var(--tf-count));
    height: 2px;
    background: var(--sl-color-text-accent);
    transform: translateX(calc(var(--tf-index) * 100%));
    transition: transform 520ms var(--tf-ease);
  }

  .task-flow__tab {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.7rem 0.75rem 0.8rem;
    border: 0;
    border-radius: 0.5rem 0.5rem 0 0;
    background: transparent;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
    text-align: start;
    cursor: pointer;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .task-flow__tab-number {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .task-flow__tab:hover {
    color: var(--sl-color-text-high);
    background: color-mix(in srgb, var(--sl-color-bg-nav) 80%, transparent);
  }

  .task-flow__tab[aria-selected='true'] {
    color: var(--sl-color-text-high);
  }

  .task-flow__tab[aria-selected='true'] .task-flow__tab-number {
    color: var(--sl-color-text-accent);
  }

  .task-flow[data-enhanced] .task-flow__panels {
    gap: 0;
  }

  .task-flow[data-enhanced] .task-flow__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .task-flow[data-enhanced] .task-flow__panel {
    grid-area: 1 / 1;
    visibility: hidden;
    z-index: 0;
    min-width: 0;
  }

  .task-flow[data-enhanced] .task-flow__panel.is-active,
  .task-flow[data-enhanced] .task-flow__panel.is-leaving {
    visibility: visible;
  }

  .task-flow[data-enhanced] .task-flow__panel.is-active {
    z-index: 2;
  }

  .task-flow[data-enhanced] .task-flow__panel.is-leaving {
    z-index: 1;
  }

  /* Incoming screenshot: wipes in from the side the reader is moving toward, easing out of a slight pan. */
  .task-flow[data-enhanced] .task-flow__frame {
    clip-path: inset(0 100% 0 0);
  }

  .task-flow[data-enhanced][data-dir='back'] .task-flow__frame {
    clip-path: inset(0 0 0 100%);
  }

  .task-flow[data-enhanced] .task-flow__image {
    transform: translateX(3%) scale(1.06);
    transform-origin: 0 50%;
  }

  .task-flow[data-enhanced][data-dir='back'] .task-flow__image {
    transform: translateX(-3%) scale(1.06);
    transform-origin: 100% 50%;
  }

  .task-flow[data-enhanced] .task-flow__panel.is-active .task-flow__frame {
    clip-path: inset(0 0 0 0);
    transition: clip-path var(--tf-dur) var(--tf-ease);
  }

  .task-flow[data-enhanced] .task-flow__panel.is-active .task-flow__image {
    transform: none;
    transition: transform calc(var(--tf-dur) * 1.4) var(--tf-ease);
  }

  .task-flow[data-enhanced] .task-flow__panel.is-leaving .task-flow__frame {
    clip-path: inset(0 0 0 0);
  }

  .task-flow[data-enhanced] .task-flow__panel.is-leaving .task-flow__image {
    transform: none;
  }

  /* Text: the outgoing step clears quickly, the incoming one settles in behind the wipe. */
  .task-flow[data-enhanced] .task-flow__caption,
  .task-flow[data-enhanced] .task-flow__text {
    opacity: 0;
    transform: translateY(6px);
  }

  .task-flow[data-enhanced] .task-flow__panel.is-active .task-flow__caption,
  .task-flow[data-enhanced] .task-flow__panel.is-active .task-flow__text {
    opacity: 1;
    transform: none;
    transition:
      opacity 420ms ease 200ms,
      transform 520ms var(--tf-ease) 200ms;
  }

  .task-flow[data-enhanced] .task-flow__panel.is-leaving .task-flow__caption,
  .task-flow[data-enhanced] .task-flow__panel.is-leaving .task-flow__text {
    transition: opacity 140ms ease;
  }

  @media (max-width: 40rem) {
    .task-flow__tab {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
      padding-inline: 0.5rem;
      font-size: var(--sl-text-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .task-flow__tabs::after,
    .task-flow[data-enhanced] .task-flow__panel .task-flow__frame,
    .task-flow[data-enhanced] .task-flow__panel .task-flow__image,
    .task-flow[data-enhanced] .task-flow__panel .task-flow__caption,
    .task-flow[data-enhanced] .task-flow__panel .task-flow__text {
      transition: none !important;
    }

    .task-flow[data-enhanced] .task-flow__image,
    .task-flow[data-enhanced][data-dir='back'] .task-flow__image {
      transform: none;
    }
  }
</style>
