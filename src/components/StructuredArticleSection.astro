---
// Body of one article section. The section heading itself is a real Markdown heading in the generated
// page, so Starlight lists it in "On this page" and gives it an anchor.
import { getStructuredArticleViewModel } from '@/lib/articles.mjs';
import { resolveComparisonLayout } from '@/lib/comparison-layout.mjs';
import { getStructuredArticleCopy } from '@/lib/structured-article-copy.mjs';
import StructuredArticleBlocks from './StructuredArticleBlocks.astro';

const locale = typeof Astro.props.locale === 'string' ? Astro.props.locale : 'zh-CN';
const slug = typeof Astro.props.slug === 'string' ? Astro.props.slug : '';
const index = Number(Astro.props.index);
const article = getStructuredArticleViewModel(slug, locale);
const section = article.sections[index];

if (!section) {
  throw new Error(`Structured article ${slug} has no section at index ${index}.`);
}

// Recognised comparison articles give every section the role it plays for the reader; others render generically.
const layout = resolveComparisonLayout(article.sections);
const role = layout?.roles[index] ?? null;
const copy = getStructuredArticleCopy(article.requestedLocale);
---

<div class="structured-article-section" data-section-id={section.id} data-role={role}>
  <StructuredArticleBlocks
    blocks={section.blocks}
    locale={article.requestedLocale}
    role={role}
    agentName={layout?.agentName}
    hagicodeName={layout?.hagicodeName}
    chooseWhen={copy.chooseWhen}
  />
</div>

<style>
  .structured-article-section {
    max-width: 48rem;
  }
</style>
