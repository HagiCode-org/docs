---
import { gaEventAttributes } from '@hagicode/hagilight-core/analytics-events';
import { getRelatedStructuredArticles, getStructuredArticleViewModel, localizeDocsHref } from '@/lib/articles.mjs';
import { getStructuredArticleCopy } from '@/lib/structured-article-copy.mjs';
import StructuredArticleCtaSection from './StructuredArticleCtaSection.astro';

const locale = typeof Astro.props.locale === 'string' ? Astro.props.locale : 'zh-CN';
const slug = typeof Astro.props.slug === 'string' ? Astro.props.slug : '';
const article = getStructuredArticleViewModel(slug, locale);
const copy = getStructuredArticleCopy(article.requestedLocale);
const related = getRelatedStructuredArticles(slug, article.requestedLocale);
const hasInlineCtaGroup = article.sections.some((section) =>
  section.blocks.some((block) => block.type === 'cta-group')
);
const hasDataCta = Boolean(article.cta.primary || article.cta.secondary);
const installHref = localizeDocsHref('/installation/desktop/', article.requestedLocale);
---

<footer class="structured-article-footer">
  {!hasInlineCtaGroup && hasDataCta ? (
    <StructuredArticleCtaSection cta={article.cta} locale={article.requestedLocale} />
  ) : null}

  {!hasInlineCtaGroup && !hasDataCta ? (
    <aside class="structured-article-install">
      <p class="structured-article-install__title">{copy.ctaTitle}</p>
      <p class="structured-article-install__text">{copy.ctaDescription}</p>
      <a
        class="structured-article-install__button"
        href={installHref}
        {...gaEventAttributes({ category: 'navigation', label: 'articleCtaPrimary', location: 'article_cta' })}
      >{copy.ctaButton}</a>
    </aside>
  ) : null}

  {related.length > 0 ? (
    <nav class="structured-article-related" aria-label={copy.relatedTitle}>
      <p class="structured-article-related__title">{copy.relatedTitle}</p>
      <ul>
        {related.map((item) => (
          <li><a href={item.href}>{copy.vsLabel.replace('{agent}', item.agentName)}</a></li>
        ))}
      </ul>
    </nav>
  ) : null}
</footer>

<style>
  .structured-article-footer {
    display: grid;
    gap: 2rem;
    max-width: 48rem;
    margin-top: 2.5rem;
  }

  .structured-article-install {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 4px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }

  .structured-article-install__title {
    margin: 0 0 0.25rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .structured-article-install__text {
    margin: 0 0 0.9rem;
    color: var(--sl-color-text);
  }

  .structured-article-install__button {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    font-weight: 600;
    text-decoration: none;
  }

  .structured-article-install__button:hover,
  .structured-article-install__button:focus-visible {
    background: var(--sl-color-accent-high);
  }

  .structured-article-related__title {
    margin: 0 0 0.6rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .structured-article-related ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .structured-article-related li {
    margin: 0;
  }

  .structured-article-related a {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .structured-article-related a:hover,
  .structured-article-related a:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }
</style>
